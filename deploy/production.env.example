# Non-secret settings for /opt/ai-chat/runtime/production.env.
AICHAT_IMAGE=ai-chat-backend:production
AICHAT_APP_PORT=18083
AICHAT_MANAGEMENT_PORT=19092
AICHAT_SERVICE_NAME=ai-chat-production
AICHAT_NETWORK_ALIAS=ai-chat-production
AICHAT_OPS_LOG_FILE=/var/log/ai-chat/production-operations.jsonl
DEPLOYMENT_ENVIRONMENT=cloud-production
NACOS_SERVER_ADDR=nacos:8848
AICHAT_NACOS_DISCOVERY_ENABLED=true
AICHAT_RABBITMQ_DYNAMIC=true
AICHAT_RABBITMQ_LISTENER_AUTO_STARTUP=true
AICHAT_SCHEDULING_ENABLED=true
AICHAT_FLYWAY_ENABLED=true
AICHAT_ELASTICSEARCH_SYNC_ENABLED=true
AICHAT_HEALTH_CHECK_ENABLED=false
AICHAT_MODEL_WARMUP_ENABLED=true
AICHAT_REQUIRE_NACOS_AUTH=true
ELASTICSEARCH_SERVER_ADDR=elasticsearch-v9:9200
AICHAT_REQUIRE_ELASTICSEARCH_AUTH=true
AICHAT_ELASTICSEARCH_REQUIRED_VERSION=9.3.2
AICHAT_ELASTICSEARCH_REQUIRE_IK=true
# Keep false until the maintenance window and old production writers are stopped.
AICHAT_PRODUCTION_CONFIRMED=false
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
AIDIAG_SECRETS_DIR=/opt/aidiag/runtime/.secrets
AICHAT_SECRETS_DIR=/opt/ai-chat/runtime/.secrets/production
