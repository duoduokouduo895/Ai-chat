# Non-secret settings for /opt/ai-chat/runtime/candidate.env.
AICHAT_IMAGE=ai-chat-backend:candidate
AICHAT_APP_PORT=18082
AICHAT_MANAGEMENT_PORT=19091
AICHAT_SERVICE_NAME=ai-chat-candidate
AICHAT_NETWORK_ALIAS=ai-chat-candidate
AICHAT_OPS_LOG_FILE=/var/log/ai-chat/operations.jsonl
DEPLOYMENT_ENVIRONMENT=cloud-candidate
AICHAT_NACOS_DISCOVERY_ENABLED=false
AICHAT_RABBITMQ_DYNAMIC=false
AICHAT_RABBITMQ_LISTENER_AUTO_STARTUP=false
AICHAT_SCHEDULING_ENABLED=false
AICHAT_FLYWAY_ENABLED=false
AICHAT_ELASTICSEARCH_SYNC_ENABLED=false
AICHAT_HEALTH_CHECK_ENABLED=false
AICHAT_MODEL_WARMUP_ENABLED=false
# Set true only after Nacos authentication and the two file secrets are ready.
AICHAT_REQUIRE_NACOS_AUTH=false
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
AIDIAG_SECRETS_DIR=/opt/aidiag/runtime/.secrets
AICHAT_SECRETS_DIR=/opt/ai-chat/runtime/.secrets
