# 后端配置不再来自 Nacos，应用启动时读取外部配置目录（默认 ~/.ai-chat，不在仓库内）：
#   application.properties      环境地址与业务参数（数据库/Redis/RabbitMQ/ES 地址、模型目录等）
#   secrets/<属性名>             每个密钥一个文件，文件名即属性名，例如 secrets/spring.r2dbc.password
# 外部文件覆盖 jar 内 application.properties 的默认值。需要改用其他目录时设置：
SPRING_PROFILES_ACTIVE=prod
AICHAT_CONFIG_DIR=
AICHAT_CONFIG_SECRETS_DIR=
# Optional Prometheus scrape Basic Auth (default off). Flip together with ai-ops
# AI_CHAT_PROMETHEUS_USERNAME / AI_CHAT_PROMETHEUS_PASSWORD — never commit real secrets.
# AICHAT_PROMETHEUS_AUTH_ENABLED=true
# Prefer secrets configtree: app.security.actuator.prometheus-username / prometheus-password
