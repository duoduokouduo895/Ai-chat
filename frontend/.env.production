# 生产环境配置
# 基础路径配置 - 用于解决部署时的资源路径问题
VITE_BASE_PATH=/

# 如果部署在子目录下，请修改为对应的路径
# 例如：VITE_BASE_PATH=/my-app/
# 例如：VITE_BASE_PATH=/frontend/

# API基础URL（Cloudflare Pages 前端需显式走后端域名）
VITE_API_BASE_URL=https://api.dduo.me/api

# Vite 8's OXC minifier produced an Axios runtime error in the production
# browser bundle. Use the compatible Terser path until the upstream issue is
# resolved and covered by a browser smoke test.
VITE_MINIFY=terser
